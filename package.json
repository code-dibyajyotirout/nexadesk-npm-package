{
  "name": "nexadesk",
  "version": "1.0.0",
  "description": "Client-side touchless 2D window manager and spatial workspace powered by MediaPipe hand tracking and CSS Glassmorphism.",
  "license": "AGPL-3.0-only",
  "author": "NexaDesk Contributors",
  "homepage": "https://github.com/code-dibyajyotirout/nexadesk-npm-package#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-dibyajyotirout/nexadesk-npm-package.git"
  },
  "bugs": {
    "url": "https://github.com/code-dibyajyotirout/nexadesk-npm-package/issues"
  },
  "keywords": [
    "spatial-computing",
    "window-manager",
    "mediapipe",
    "hand-tracking",
    "touchless",
    "nextjs",
    "react",
    "glassmorphism",
    "web-desktop",
    "agpl"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js",
      "require": "./dist/hooks/index.js",
      "default": "./dist/hooks/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "require": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run build:lib && next build",
    "build:lib": "node scripts/build-lib.js",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build:lib",
    "prepare": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "next": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}
